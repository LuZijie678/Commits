    "top5_repository_max_fraction": 0.25
  },
  "model_requirements": {
    "use_null_slot": true,
    "seeds": [
      13,
      42,
      2026,
      2607,
      7240
    ]
  },
  "baseline_matrix": {
    "required_baselines": [
      "all_one",
