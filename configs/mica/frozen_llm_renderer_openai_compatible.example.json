{
  "enabled": false,
  "provider": "openai_compatible",
  "base_url": "https://api.example.com/v1",
  "api_key_env": "MICA_FROZEN_LLM_API_KEY",
  "model": "example-chat-model",
  "temperature": 0.2,
  "top_p": 1.0,
  "max_output_tokens": 64,
  "timeout_seconds": 60,
  "max_retries": 2,
  "thinking": {
    "type": "disabled"
  },
  "cache_path": "outputs/frozen_llm_generation_cache.json"
}
